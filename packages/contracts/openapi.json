{
  "components": {
    "schemas": {
      "CandidateIn": {
        "properties": {
          "backend_id": {
            "title": "Backend Id",
            "type": "string"
          },
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "decoder_latency_s": {
            "default": 0.0,
            "title": "Decoder Latency S",
            "type": "number"
          },
          "estimated_cost_usd": {
            "minimum": 0.0,
            "title": "Estimated Cost Usd",
            "type": "number"
          },
          "estimated_qpu_seconds": {
            "minimum": 0.0,
            "title": "Estimated Qpu Seconds",
            "type": "number"
          },
          "qubit_overhead": {
            "default": 0.0,
            "title": "Qubit Overhead",
            "type": "number"
          },
          "rmse": {
            "minimum": 0.0,
            "title": "Rmse",
            "type": "number"
          },
          "strategy_id": {
            "title": "Strategy Id",
            "type": "string"
          }
        },
        "required": [
          "candidate_id",
          "backend_id",
          "strategy_id",
          "estimated_cost_usd",
          "rmse",
          "estimated_qpu_seconds"
        ],
        "title": "CandidateIn",
        "type": "object"
      },
      "CircuitAnalyzeRequest": {
        "properties": {
          "depth": {
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "has_classical_feedback": {
            "default": false,
            "title": "Has Classical Feedback",
            "type": "boolean"
          },
          "has_mid_circuit_measurement": {
            "default": false,
            "title": "Has Mid Circuit Measurement",
            "type": "boolean"
          },
          "measurement_count": {
            "minimum": 0.0,
            "title": "Measurement Count",
            "type": "integer"
          },
          "qubit_count": {
            "minimum": 1.0,
            "title": "Qubit Count",
            "type": "integer"
          },
          "single_qubit_gate_count": {
            "minimum": 0.0,
            "title": "Single Qubit Gate Count",
            "type": "integer"
          },
          "two_qubit_gate_count": {
            "minimum": 0.0,
            "title": "Two Qubit Gate Count",
            "type": "integer"
          }
        },
        "required": [
          "qubit_count",
          "depth",
          "two_qubit_gate_count",
          "single_qubit_gate_count",
          "measurement_count"
        ],
        "title": "CircuitAnalyzeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OptimizeRequest": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateIn"
            },
            "minItems": 1,
            "title": "Candidates",
            "type": "array"
          },
          "goal": {
            "$ref": "#/components/schemas/ReliabilityGoal"
          }
        },
        "required": [
          "goal",
          "candidates"
        ],
        "title": "OptimizeRequest",
        "type": "object"
      },
      "QasmRequest": {
        "description": "A user-supplied OpenQASM 2 or 3 circuit. Limits are enforced by the parser, not here.",
        "properties": {
          "qasm": {
            "minLength": 1,
            "title": "Qasm",
            "type": "string"
          }
        },
        "required": [
          "qasm"
        ],
        "title": "QasmRequest",
        "type": "object"
      },
      "QecSimulateRequest": {
        "properties": {
          "code": {
            "enum": [
              "repetition",
              "rotated_surface"
            ],
            "title": "Code",
            "type": "string"
          },
          "decoder_id": {
            "default": "mwpm_pymatching",
            "title": "Decoder Id",
            "type": "string"
          },
          "distance": {
            "title": "Distance",
            "type": "integer"
          },
          "max_errors": {
            "default": 1000,
            "minimum": 1.0,
            "title": "Max Errors",
            "type": "integer"
          },
          "max_shots": {
            "default": 20000,
            "maximum": 200000.0,
            "minimum": 1.0,
            "title": "Max Shots",
            "type": "integer"
          },
          "noise_model": {
            "enum": [
              "code_capacity",
              "phenomenological",
              "circuit_level"
            ],
            "title": "Noise Model",
            "type": "string"
          },
          "p": {
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "P",
            "type": "number"
          },
          "rounds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rounds"
          },
          "seed": {
            "default": 0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "distance",
          "noise_model",
          "p"
        ],
        "title": "QecSimulateRequest",
        "type": "object"
      },
      "Quantity": {
        "additionalProperties": false,
        "properties": {
          "method_ref": {
            "title": "Method Ref",
            "type": "string"
          },
          "provenance": {
            "enum": [
              "measured",
              "simulated",
              "heuristic",
              "demo_fixture",
              "planning_estimate"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "unit": {
            "enum": [
              "probability",
              "expectation_value",
              "ratio",
              "usd",
              "seconds",
              "microseconds",
              "count"
            ],
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit",
          "provenance",
          "method_ref"
        ],
        "title": "Quantity",
        "type": "object"
      },
      "ReliabilityGoal": {
        "additionalProperties": false,
        "properties": {
          "confidence_target": {
            "title": "Confidence Target",
            "type": "number"
          },
          "max_cost_usd": {
            "$ref": "#/components/schemas/Quantity"
          },
          "max_runtime_seconds": {
            "$ref": "#/components/schemas/Quantity"
          },
          "priority": {
            "enum": [
              "minimize_cost",
              "balanced",
              "maximize_accuracy",
              "custom"
            ],
            "title": "Priority",
            "type": "string"
          },
          "target_error": {
            "$ref": "#/components/schemas/Quantity"
          },
          "task": {
            "$ref": "#/components/schemas/TaskSpec"
          },
          "weights": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreWeights"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "target_error",
          "task",
          "confidence_target",
          "max_cost_usd",
          "max_runtime_seconds",
          "priority"
        ],
        "title": "ReliabilityGoal",
        "type": "object"
      },
      "ScoreWeights": {
        "additionalProperties": false,
        "description": "\u00a729. Presets map to fixed, documented weight vectors; they are not free-floating.",
        "properties": {
          "w_cost": {
            "title": "W Cost",
            "type": "number"
          },
          "w_decoder_latency": {
            "title": "W Decoder Latency",
            "type": "number"
          },
          "w_error": {
            "title": "W Error",
            "type": "number"
          },
          "w_qubit_overhead": {
            "title": "W Qubit Overhead",
            "type": "number"
          },
          "w_time": {
            "title": "W Time",
            "type": "number"
          }
        },
        "required": [
          "w_error",
          "w_cost",
          "w_time",
          "w_qubit_overhead",
          "w_decoder_latency"
        ],
        "title": "ScoreWeights",
        "type": "object"
      },
      "SubmitJobRequest": {
        "properties": {
          "backend_id": {
            "description": "IBM backend name, e.g. ibm_brisbane.",
            "title": "Backend Id",
            "type": "string"
          },
          "qasm": {
            "description": "Complete OpenQASM 2 source to run.",
            "title": "Qasm",
            "type": "string"
          },
          "shots": {
            "default": 1024,
            "description": "Capped server-side by QRP_MAX_SHOTS.",
            "minimum": 1.0,
            "title": "Shots",
            "type": "integer"
          }
        },
        "required": [
          "qasm",
          "backend_id"
        ],
        "title": "SubmitJobRequest",
        "type": "object"
      },
      "TaskSpec": {
        "additionalProperties": false,
        "description": "WHAT is being estimated (mirrors apps/web/src/services/contracts.ts `TaskSpec`).\n\nNot cosmetic: it decides which error metric the target is expressed in, and therefore which\nstrategies can even be considered. An expectation-value technique like ZNE has no meaning for a\nsampling task, so the optimizer refuses one rather than scoring it with the wrong model.",
        "properties": {
          "metric": {
            "enum": [
              "absolute_expectation_error",
              "total_variation_distance"
            ],
            "title": "Metric",
            "type": "string"
          },
          "observable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observable"
          },
          "type": {
            "enum": [
              "observable",
              "sampling"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "metric"
        ],
        "title": "TaskSpec",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Quantum Reliability Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backends": {
      "get": {
        "description": "Demo backends plus the adapters that are declared-but-not-implemented.",
        "operationId": "list_backends_api_v1_backends_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Backends Api V1 Backends Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Backends",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/backends/{backend_id}": {
      "get": {
        "operationId": "get_backend_api_v1_backends__backend_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "backend_id",
            "required": true,
            "schema": {
              "title": "Backend Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Backend Api V1 Backends  Backend Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Backend",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/backends/{backend_id}/calibration": {
      "get": {
        "operationId": "get_calibration_api_v1_backends__backend_id__calibration_get",
        "parameters": [
          {
            "in": "path",
            "name": "backend_id",
            "required": true,
            "schema": {
              "title": "Backend Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Calibration Api V1 Backends  Backend Id  Calibration Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Calibration",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/circuits/analyze": {
      "post": {
        "description": "Derived circuit features the optimizer and the compatibility matrix consume.",
        "operationId": "analyze_circuit_api_v1_circuits_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CircuitAnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Analyze Circuit Api V1 Circuits Analyze Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Circuit",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/circuits/parse": {
      "post": {
        "description": "Parse a real circuit into the profile the optimizer consumes.\n\nRejects oversized or unsupported input with a structured reason code \u2014 the caller can map it\nstraight onto the shared preflight vocabulary.",
        "operationId": "parse_circuit_api_v1_circuits_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QasmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Parse Circuit Api V1 Circuits Parse Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parse Circuit",
        "tags": [
          "circuits"
        ]
      }
    },
    "/api/v1/execution/jobs": {
      "get": {
        "description": "Jobs this process knows about. Never includes a credential.",
        "operationId": "list_jobs_api_v1_execution_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Jobs Api V1 Execution Jobs Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Jobs",
        "tags": [
          "execution"
        ]
      },
      "post": {
        "description": "Submit a circuit to real hardware. 202 with a job id; poll for the result.\n\n503 when submission is disabled or credentials are unusable, 402 when the account's plan could\ncost money \u2014 never a fabricated result.",
        "operationId": "submit_job_api_v1_execution_jobs_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-QRP-IBM-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Qrp-Ibm-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit Job Api V1 Execution Jobs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Job",
        "tags": [
          "execution"
        ]
      }
    },
    "/api/v1/execution/jobs/{job_id}": {
      "get": {
        "description": "Poll one job. Job state is in-memory and does not survive a restart \u2014 see `durability`.",
        "operationId": "get_job_api_v1_execution_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-QRP-IBM-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Qrp-Ibm-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Job Api V1 Execution Jobs  Job Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job",
        "tags": [
          "execution"
        ]
      }
    },
    "/api/v1/execution/status": {
      "get": {
        "description": "What this deployment will and will not do. Safe to expose; contains no secret.",
        "operationId": "execution_status_api_v1_execution_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Execution Status Api V1 Execution Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Execution Status",
        "tags": [
          "execution"
        ]
      }
    },
    "/api/v1/preflight": {
      "post": {
        "description": "RUN / RUN_WITH_WARNING / DO_NOT_RUN / INSUFFICIENT_DATA, computed from the findings.",
        "operationId": "preflight_api_v1_preflight_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Preflight Api V1 Preflight Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Preflight",
        "tags": [
          "optimizer"
        ]
      }
    },
    "/api/v1/providers": {
      "get": {
        "description": "Which adapters can actually serve data right now, and why not when they cannot.",
        "operationId": "providers_api_v1_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Providers Api V1 Providers Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Providers",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/providers/ibm/backends": {
      "get": {
        "description": "Live IBM Quantum backends. 503 (never a fabricated list) when unavailable.",
        "operationId": "ibm_backends_api_v1_providers_ibm_backends_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ibm Backends Api V1 Providers Ibm Backends Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ibm Backends",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/providers/ibm/backends/{backend_id}/calibration": {
      "get": {
        "description": "Real measured calibration: T1/T2, readout error, per-coupler two-qubit error.",
        "operationId": "ibm_calibration_api_v1_providers_ibm_backends__backend_id__calibration_get",
        "parameters": [
          {
            "in": "path",
            "name": "backend_id",
            "required": true,
            "schema": {
              "title": "Backend Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ibm Calibration Api V1 Providers Ibm Backends  Backend Id  Calibration Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ibm Calibration",
        "tags": [
          "hardware"
        ]
      }
    },
    "/api/v1/qec/simulate": {
      "post": {
        "description": "Runs a real Stim + PyMatching simulation. Results are `simulated`, never measured.",
        "operationId": "qec_simulate_api_v1_qec_simulate_post",
        "requestBody": {
