# Copy to .env and fill in locally. Never commit .env.
# RECON-29: only VITE_* vars on this allowlist may exist; CI fails the build on any
# VITE_.*(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL) name, since anything prefixed VITE_ is
# bundled into the public, static frontend.

# Display name shown in the app shell.
VITE_APP_NAME=Quantum Reliability Platform

# Vite base path — must match the GitHub Pages repo path (username.github.io/<repo>/).
VITE_BASE_PATH=/quantum-reliability-platform/

# Set to "true" to force the static DemoReliabilityDataSource (RECON-2/§49).
VITE_DEMO_MODE=true
